# Copy to .env and fill in. Never commit .env or paste these values into chat.

# --- Site (Caddy) ---
# Local: leave as :80 (plain HTTP on http://localhost).
# Linode: set to the bare domain, e.g. anchorpoint.example.com (Caddy then gets HTTPS certs itself).
SITE_ADDRESS=:80

# Frontend build: auto falls back to demo fixtures when an endpoint is missing; live never does.
# Set live on the Linode so nothing on the demo site is faked.
VITE_API_MODE=auto

# --- Google OAuth (P4) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:8000/api/oauth/callback
# Linode: https://<domain>/api/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/callback

# Where the OAuth callback sends the browser afterwards. Empty on the Linode (same origin).
FRONTEND_URL=http://localhost

# Seeder client (Desktop app). Only POST /api/demo/inject uses it, with an insert-only grant.
SEED_GOOGLE_CLIENT_ID=
SEED_GOOGLE_CLIENT_SECRET=

# --- Plaid (P1) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Akamai inference (P1) ---
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
MODEL_ID=

# --- Token vault (P2) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# --- App ---
DATABASE_URL=sqlite:////data/anchorpoint.db
# Comma-separated. Add https://<domain> on the Linode.
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Seconds between background syncs; 0 turns the poll off (POST /api/sync still works).
SYNC_INTERVAL_S=60

# --- Deploy (only needed on the machine that runs `make deploy`) ---
DEPLOY_HOST=
DEPLOY_DIR=/opt/anchorpoint
BASE_URL=http://localhost
